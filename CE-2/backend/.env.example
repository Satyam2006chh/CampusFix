# ──────────────────────────────────────────────────────────────
# CampusFix CE-2 — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Server port
PORT=5000

# ── DATABASE ──────────────────────────────────────────────────
# Option 1: Use local JSON file (no MongoDB needed) — set to true
USE_JSON_DB=true

# Option 2: Use MongoDB — comment out USE_JSON_DB and set your URI
# MONGO_URI=mongodb://localhost:27017/campusfix
# or Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusfix

# ── AUTH ──────────────────────────────────────────────────────
JWT_SECRET=campusfix_super_secret_key_2024
JWT_EXPIRE=7d

# ── ENVIRONMENT ───────────────────────────────────────────────
NODE_ENV=development
