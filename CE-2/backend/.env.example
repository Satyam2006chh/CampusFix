# ──────────────────────────────────────────────────────────────
# CampusFix CE-2 — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Server port
PORT=5000

# ── DATABASE ──────────────────────────────────────────────────
# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/campusfix
# or Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusfix

# ── AUTH ──────────────────────────────────────────────────────
JWT_SECRET=campusfix_super_secret_key_2024
JWT_EXPIRE=7d

# ── ENVIRONMENT ───────────────────────────────────────────────
NODE_ENV=development

# ── EMAIL (OTP & Mail Service) ────────────────────────────────
EMAIL_SERVICE=gmail
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
OTP_EXPIRE_MINUTES=10

# ── RESEND (Email / OTP delivery) ────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ── AI SERVICES (Google Gemini & Fallback) ───────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
